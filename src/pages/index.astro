---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Tactile Header -->
  <header class="flex items-center justify-between pb-12 border-b border-zinc-800/80">
    <a href="/" class="text-sm font-semibold tracking-wide text-zinc-100 hover:text-orange-400 transition-colors">
      kritika<span class="text-orange-500">.</span>dev
    </a>

    <nav class="flex items-center gap-2 text-xs">
      <a
        href="https://github.com/kritikagoyal"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-300 shadow-sm hover:border-zinc-700 hover:text-orange-400 active:translate-y-0.5 transition-all"
      >
        github
      </a>
      <a
        href="https://linkedin.com/in/goyalkritika/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-300 shadow-sm hover:border-zinc-700 hover:text-orange-400 active:translate-y-0.5 transition-all"
      >
        linkedin
      </a>
      <!--
      <a
        href="/blog"
        class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-300 shadow-sm hover:border-zinc-700 hover:text-orange-400 active:translate-y-0.5 transition-all"
      >
        blog
      </a>
      -->
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg border border-orange-500/30 bg-orange-500/10 text-orange-400 font-medium shadow-sm hover:bg-orange-500/20 active:translate-y-0.5 transition-all flex items-center gap-1"
      >
        resume <span>↗</span>
      </a>
    </nav>
  </header>

  <!-- Main Hero -->
  <main class="my-auto py-16 space-y-14">
    <!-- Top Fold: Text on Left, Photo on Right -->
    <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-8">
      <!-- Left: Copy -->
      <div class="space-y-4 max-w-xl">
        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight text-zinc-100 flex items-baseline">
          Hi, I'm Kritika<span class="inline-block text-orange-500 animate-pulse font-bold">.</span>
        </h1>
        <p class="text-zinc-400 leading-relaxed text-sm md:text-base">
          I engineer distributed backends, streaming pipelines, and event-driven architectures with high concurrency and low latency.
        </p>
      </div>

      <!-- Right: Photo with Orange Accent Frame -->
      <div class="relative shrink-0 group">
        <!-- Subtle orange ambient glow behind the photo -->
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-orange-500/30 to-amber-500/10 blur-md opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>

        <!-- Image Container with double border & subtle hover pop -->
        <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border border-orange-500/40 bg-zinc-900 shadow-xl group-hover:border-orange-500/70 transition-all duration-300">
          <img
            src="/avatar.jpeg"
            alt="Kritika Goyal"
            class="w-full h-full object-cover filter grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500"
          />
        </div>

        <!-- Orange status pip accent (bottom-right) synchronized with the period -->
        <span class="absolute -bottom-1 -right-1 flex h-3.5 w-3.5">
          <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-orange-500 border-2 border-[#0c0d0e]"></span>
        </span>
      </div>
    </div>

    <!-- Selected Projects (Commented for MVP)
    <div class="space-y-4">
      <h2 class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">
        Selected Work
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="group p-5 rounded-xl border border-zinc-800/80 bg-zinc-900/40 hover:border-orange-500/40 hover:bg-zinc-900/70 transition-all flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="font-medium text-zinc-200 group-hover:text-orange-400 transition-colors">
                Firefly Asset Engine
              </h3>
              <span class="text-zinc-500 group-hover:text-orange-400 group-hover:translate-x-0.5 transition-transform text-xs">↗</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Workflow automation pipeline integrating generative prompt models into enterprise asset delivery.
            </p>
          </div>
          <div class="flex gap-2 mt-4 pt-3 border-t border-zinc-800/50 text-[11px] text-zinc-500">
            <span>Java</span> • <span>REST APIs</span> • <span>GenAI</span>
          </div>
        </div>

        <div class="group p-5 rounded-xl border border-zinc-800/80 bg-zinc-900/40 hover:border-orange-500/40 hover:bg-zinc-900/70 transition-all flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="font-medium text-zinc-200 group-hover:text-orange-400 transition-colors">
                Decoupled Messaging Engine
              </h3>
              <span class="text-zinc-500 group-hover:text-orange-400 group-hover:translate-x-0.5 transition-transform text-xs">↗</span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              High-throughput asynchronous stream processing reducing latency bottlenecks across services.
            </p>
          </div>
          <div class="flex gap-2 mt-4 pt-3 border-t border-zinc-800/50 text-[11px] text-zinc-500">
            <span>Kafka</span> • <span>Redis</span> • <span>Spring Boot</span>
          </div>
        </div>
      </div>
    </div>
    -->
  </main>

  <!-- Footer -->
  <footer class="pt-8 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500">
    <span>Kritika Goyal</span>
    <span>2026</span>
  </footer>
</Layout>