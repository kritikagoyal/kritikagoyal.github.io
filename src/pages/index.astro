---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Tactile Header -->
  <header class="flex items-center justify-between pb-12 border-b border-zinc-800/80">
    <a href="/" class="text-sm font-semibold tracking-wide text-zinc-100 hover:text-orange-400 transition-colors">
      kritika<span class="text-orange-500">.</span>dev
    </a>

    <nav class="flex items-center gap-2 text-xs">
      <a
        href="https://github.com/kritikagoyal"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-300 shadow-sm hover:border-zinc-700 hover:text-orange-400 active:translate-y-0.5 transition-all"
      >
        github
      </a>
      <a
        href="https://linkedin.com/in/goyalkritika/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-300 shadow-sm hover:border-zinc-700 hover:text-orange-400 active:translate-y-0.5 transition-all"
      >
        linkedin
      </a>
      <!--
      <a
        href="/blog"
        class="px-3 py-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 text-zinc-300 shadow-sm hover:border-zinc-700 hover:text-orange-400 active:translate-y-0.5 transition-all"
      >
        blog
      </a>
      -->
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg border border-orange-500/30 bg-orange-500/10 text-orange-400 font-medium shadow-sm hover:bg-orange-500/20 active:translate-y-0.5 transition-all flex items-center gap-1"
      >
        resume <span>↗</span>
      </a>
    </nav>
  </header>

  <!-- Centered Hero Fold -->
  <main class="my-auto py-8">
    <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-8">
      <!-- Left: Copy & Proof Metric -->
      <div class="space-y-5 max-w-xl">
        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight text-zinc-100 flex items-baseline">
          Hi, I'm Kritika<span class="inline-block text-orange-500 animate-pulse font-bold">.</span>
        </h1>
        
        <!-- 1. Precise Specialty -->
        <p class="text-zinc-400 leading-relaxed text-sm md:text-base">
          I build distributed databases and storage engines, focusing on consensus, replication, and high-throughput data access.
        </p>

        <!-- 2. Proof Metric -->
        <div class="text-xs text-zinc-500 flex items-center gap-2 pt-1 font-mono">
          <span class="text-zinc-300 font-medium">8+ yoe</span>
          <span>•</span>
          <span>Sony</span>
          <span>•</span>
          <span>Adobe</span>
          <span>•</span>
          <span>Deloitte</span>
        </div>

		<!-- Option A: Quiet Focus Stack Line -->
        <div class="text-xs font-mono text-zinc-500 flex flex-wrap items-center gap-x-2 gap-y-1 pt-1">
          <span class="text-orange-500/80 font-medium">focus:</span>
          <span>Distributed databases</span>
          <span>·</span>
          <span>Java</span>
          <span>·</span>
          <span>Microservices</span>
          <span>·</span>
          <span>CI/CD</span>
          <span>·</span>
          <span>LLM Integrations</span>
        </div>
      </div>

      <!-- Right: Photo with Orange Accent Frame -->
      <div class="relative shrink-0 group">
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-orange-500/30 to-amber-500/10 blur-md opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>

        <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden border border-orange-500/40 bg-zinc-900 shadow-xl group-hover:border-orange-500/70 transition-all duration-300">
          <img
            src="/avatar.jpeg"
            alt="Kritika Goyal"
            class="w-full h-full object-cover filter grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500"
          />
        </div>

        <span class="absolute -bottom-1 -right-1 flex h-3.5 w-3.5">
          <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-orange-500 border-2 border-[#0c0d0e]"></span>
        </span>
      </div>
    </div>
  </main>

  <!-- Clean Footer -->
  <footer class="pt-6 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-500 font-mono">
    <!-- Availability Indicator (Left) -->
    <div class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
      </span>
      <span class="text-zinc-400">Available for technical discussions</span>
    </div>

    <!-- Reachout Button (Right) -->
    <button
      id="contact-btn"
      type="button"
      data-user="goyalkritika40"
      data-domain="gmail.com"
      class="hover:text-orange-400 text-zinc-400 flex items-center gap-1.5 transition-colors cursor-pointer group"
    >
      <span class="underline decoration-zinc-800 underline-offset-4 group-hover:decoration-orange-500">get in touch</span>
      <span class="text-orange-500 font-bold group-hover:translate-x-0.5 transition-transform">→</span>
    </button>
  </footer>
</Layout>

<script>
  // Dynamically assemble and open mailto on click without revealing raw string to bots
  const contactBtn = document.getElementById('contact-btn');
  contactBtn?.addEventListener('click', () => {
    const user = contactBtn.getAttribute('data-user');
    const domain = contactBtn.getAttribute('data-domain');
    if (user && domain) {
      window.location.href = `mailto:${user}@${domain}`;
    }
  });
</script>