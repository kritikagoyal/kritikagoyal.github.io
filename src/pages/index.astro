---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Minimal Header -->
  <header class="flex items-center justify-between pb-6 border-b border-theme">
    <a href="/" class="text-sm font-semibold tracking-wide c-primary hover:c-accent transition-colors flex items-center">
      kritika<span class="c-accent font-bold">.</span>dev
    </a>

    <nav class="flex items-center gap-2 text-xs">
      <a
        href="https://github.com/kritikagoyal"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg btn-nav shadow-sm active:translate-y-0.5 transition-all"
      >
        github
      </a>
      <a
        href="https://linkedin.com/in/goyalkritika/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg btn-nav shadow-sm active:translate-y-0.5 transition-all"
      >
        linkedin
      </a>
      <!-- Blog Internal Route Link -->
      <a
        href="/blog"
        class="px-3 py-1.5 rounded-lg btn-nav shadow-sm active:translate-y-0.5 transition-all"
      >
        blog
      </a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg btn-resume font-medium shadow-sm active:translate-y-0.5 transition-all flex items-center gap-1"
      >
        resume <span>↗</span>
      </a>

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="p-1.5 rounded-lg btn-nav active:translate-y-0.5 transition-all cursor-pointer flex items-center justify-center"
      >
        <!-- Sun icon (visible when dark) -->
        <svg id="icon-sun" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
          <path stroke-linecap="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <!-- Moon icon (visible when light) -->
        <svg id="icon-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>
    </nav>
  </header>

  <!-- Centered Hero Fold -->
  <main class="my-auto py-8">
    <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-8">
      <!-- Left: Copy, Proof Metric & Focus Stack -->
      <div class="space-y-4 max-w-xl">
        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight c-primary flex items-baseline">
          Hi, I'm Kritika<span class="inline-block c-accent animate-pulse font-bold">.</span>
        </h1>
        
        <p class="c-secondary leading-relaxed text-sm md:text-base">
          I build distributed databases and storage engines, focusing on consensus, replication, and high-throughput data access.
        </p>

        <!-- Proof Metric -->
        <div class="text-xs c-muted flex items-center gap-2 font-mono">
          <span class="c-primary font-semibold">8+ yoe</span>
          <span>•</span>
          <span>Sony</span>
          <span>•</span>
          <span>Adobe</span>
          <span>•</span>
          <span>Deloitte</span>
        </div>

        <!-- Quiet Focus Stack Line -->
        <div class="text-xs font-mono c-secondary flex flex-wrap items-center gap-x-2 gap-y-1 pt-1">
          <span class="c-accent font-semibold">focus:</span>
          <span>Distributed databases</span>
          <span>·</span>
          <span>Java</span>
          <span>·</span>
          <span>Microservices</span>
          <span>·</span>
          <span>CI/CD</span>
          <span>·</span>
          <span>LLM Integrations</span>
        </div>
      </div>

      <!-- Right: Photo with Orange Accent Frame -->
      <div class="relative shrink-0 group">
        <!-- Ambient glow behind photo -->
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-orange-500/25 to-amber-500/10 blur-md opacity-70 group-hover:opacity-100 transition-opacity duration-300"></div>

        <!-- Frame -->
        <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden border border-orange-500/40 bg-zinc-200 dark:bg-zinc-900 shadow-lg group-hover:border-orange-500/70 transition-all duration-300">
          <img
            src="/avatar.jpeg"
            alt="Kritika Goyal"
            class="w-full h-full object-cover filter grayscale contrast-110 group-hover:grayscale-0 transition-all duration-500"
          />
        </div>

        <!-- Status Pip (Border dynamically matches canvas background) -->
        <span class="absolute -bottom-1 -right-1 flex h-3.5 w-3.5">
          <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-orange-500 border-2" style="border-color: var(--bg-color);"></span>
        </span>
      </div>
    </div>
  </main>

  <!-- Clean Footer -->
  <footer class="pt-6 border-t border-theme flex flex-col sm:flex-row items-center justify-between gap-3 text-xs c-muted font-mono">
    <!-- Availability Indicator (Left) -->
    <div class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
      </span>
      <span class="c-secondary">Available for technical discussions</span>
    </div>

    <!-- Reachout Button (Right) -->
    <button
      id="contact-btn"
      type="button"
      data-user="goyalkritika40"
      data-domain="gmail.com"
      class="hover:c-accent c-secondary flex items-center gap-1.5 transition-colors cursor-pointer group"
    >
      <span class="underline decoration-zinc-400 dark:decoration-zinc-700 underline-offset-4 group-hover:decoration-orange-500">get in touch</span>
      <span class="c-accent font-bold group-hover:translate-x-0.5 transition-transform">→</span>
    </button>
  </footer>
</Layout>

<script is:inline>
  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');
    if (sun && moon) {
      if (isDark) {
        sun.classList.remove('hidden');
        moon.classList.add('hidden');
      } else {
        sun.classList.add('hidden');
        moon.classList.remove('hidden');
      }
    }
  }

  // Initial icon setup
  syncThemeIcons();

  // Toggle theme click
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncThemeIcons();
  });

  // Obfuscated mailto click
  const contactBtn = document.getElementById('contact-btn');
  contactBtn?.addEventListener('click', () => {
    const user = contactBtn.getAttribute('data-user');
    const domain = contactBtn.getAttribute('data-domain');
    if (user && domain) {
      window.location.href = `mailto:${user}@${domain}`;
    }
  });
</script>