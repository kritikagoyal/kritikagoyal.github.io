---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BlogLayout title="blog" description="Essays on distributed databases, storage engines, and consensus.">
  <section class="space-y-10">
    <!-- Section Introduction -->
    <div class="space-y-2 border-b border-theme pb-6">
      <h1 class="text-2xl font-semibold tracking-tight c-primary">
        Writing<span class="c-accent">.</span>
      </h1>
    </div>

    <!-- Posts Listing -->
    <div class="space-y-8">
      {posts.length === 0 ? (
        <p class="text-xs font-mono c-muted">No posts published yet.</p>
      ) : (
        posts.map((post) => (
          <article class="group">
            <a href={`/blog/${post.id}`} class="block space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h2 class="text-base font-medium c-primary group-hover:c-accent transition-colors">
                  {post.data.title}
                </h2>
                <time class="text-xs font-mono c-muted shrink-0">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
              </div>

              <p class="text-sm c-secondary leading-relaxed line-clamp-2">
                {post.data.description}
              </p>

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-1">
                  {post.data.tags.map((tag) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded border border-theme c-muted">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))
      )}
    </div>
  </section>
</BlogLayout>