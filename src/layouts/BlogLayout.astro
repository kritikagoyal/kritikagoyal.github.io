---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Writing — Kritika Goyal", 
  description = "Technical deep-dives on distributed databases, consensus, and storage engines." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Zero-flicker theme initialization -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between max-w-3xl mx-auto px-6 py-8 font-mono antialiased selection:bg-orange-500/25 selection:text-orange-500">
    <div>
      <!-- Minimal Header -->
      <header class="flex items-center justify-between pb-6 border-b border-theme">
        <a href="/" class="text-sm font-semibold tracking-wide c-primary hover:c-accent transition-colors flex items-center">
          kritika<span class="c-accent font-bold">.</span>dev
        </a>

        <nav class="flex items-center gap-2 text-xs">
          <a
            href="/"
            class="px-3 py-1.5 rounded-lg btn-nav shadow-sm active:translate-y-0.5 transition-all"
          >
            ← home
          </a>
          <a
            href="https://github.com/kritikagoyal"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg btn-nav shadow-sm active:translate-y-0.5 transition-all hidden sm:inline-block"
          >
            github
          </a>
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg btn-resume font-medium shadow-sm active:translate-y-0.5 transition-all flex items-center gap-1"
          >
            resume <span>↗</span>
          </a>

          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            class="p-1.5 rounded-lg btn-nav active:translate-y-0.5 transition-all cursor-pointer flex items-center justify-center"
          >
            <svg id="icon-sun" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg id="icon-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
          </button>
        </nav>
      </header>

      <main class="py-10">
        <slot />
      </main>
    </div>

    <!-- Persistent Minimal Footer -->
    <footer class="pt-6 pb-2 border-t border-theme flex flex-col sm:flex-row items-center justify-between gap-3 text-xs c-muted font-mono">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
        </span>
        <span class="c-secondary">Available for technical discussions</span>
      </div>

      <button
        id="contact-btn"
        type="button"
        data-user="goyalkritika40"
        data-domain="gmail.com"
        class="hover:c-accent c-secondary flex items-center gap-1.5 transition-colors cursor-pointer group"
      >
        <span class="underline decoration-zinc-400 dark:decoration-zinc-700 underline-offset-4 group-hover:decoration-orange-500">get in touch</span>
        <span class="c-accent font-bold group-hover:translate-x-0.5 transition-transform">→</span>
      </button>
    </footer>

    <script is:inline>
      function syncThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');
        if (sun && moon) {
          if (isDark) {
            sun.classList.remove('hidden');
            moon.classList.add('hidden');
          } else {
            sun.classList.add('hidden');
            moon.classList.remove('hidden');
          }
        }
      }

      syncThemeIcons();

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncThemeIcons();
      });

      const contactBtn = document.getElementById('contact-btn');
      contactBtn?.addEventListener('click', () => {
        const user = contactBtn.getAttribute('data-user');
        const domain = contactBtn.getAttribute('data-domain');
        if (user && domain) {
          window.location.href = `mailto:${user}@${domain}`;
        }
      });
    </script>
  </body>
</html>