---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Kritika Goyal" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="flex flex-col min-h-screen justify-between max-w-3xl mx-auto px-6 py-12 text-zinc-300 font-mono antialiased selection:bg-orange-500/25 selection:text-orange-400">
    <slot />
  </body>
</html>